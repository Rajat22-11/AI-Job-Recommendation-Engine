# Copy to .env.local for local development. Never commit real values.
# All of these are read on the server only; none may use the NEXT_PUBLIC_ prefix.

# Supabase project "Jobs Recommendation Engine" (Project Settings > API).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the login page.
APP_PASSWORD=choose-a-long-password

# Signs the session cookie. At least 32 characters; changing it logs you out everywhere.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
