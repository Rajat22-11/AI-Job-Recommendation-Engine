# Copy to .env.local (git-ignored) for local runs. On Render, set the same names in the service's
# Environment tab instead. A variable already set in the real environment wins over this file.
# List variables take several values separated by commas; the next one is used when one hits a quota.

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# LinkedIn influencer posts (Apify). Several accounts: token1,token2
APIFY_TOKENS=

# Optional: only used when scoring.gemini.enabled is true in config/settings.yaml
GEMINI_API_KEYS=

# Notifications (ntfy topic name acts as the secret) and optional heartbeat ping
NTFY_TOPIC=
HEARTBEAT_URL=

# Only for running the web service locally (uvicorn); one or more shared secrets
TRIGGER_SECRETS=

# Optional: use a different file than .env.local
# JOB_AGGREGATOR_ENV_FILE=C:\path\to\other.env
